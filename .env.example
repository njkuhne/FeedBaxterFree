# Compose only: host port for the UI and API (default 8080). Set it in the shell, e.g.
#   FEEDBAXTER_PORT=8095 docker compose -f deploy/docker-compose.yml up -d --build
# FEEDBAXTER_PORT=8080
# All modes. ingest, worker, api or all.
MODE=all
# api, all. UI, API and MCP listener.
HTTP_ADDR=:8080
# ingest. In all mode ingest is also mounted on HTTP_ADDR.
INGEST_ADDR=:8081
# all. SQLite file and NATS store.
DATA_DIR=/data
# api, all. Email of the admin created on first boot (self-host). The temporary password is logged once.
ADMIN_EMAIL=admin@localhost
# worker, api, all. Defaults to a SQLite file in DATA_DIR; a postgres:// URL selects Postgres.
# DATABASE_URL=sqlite:///data/feedbaxter.db
# ingest, worker, api. Empty uses the embedded server; required unless MODE=all.
# NATS_URL=
# api. How often the key cache is reconciled from the database.
KEY_CACHE_RESYNC_INTERVAL=5m
# ingest. How often counters are flushed to NATS KV.
COUNTER_FLUSH_INTERVAL=5s
# worker. Retention window (17520h is 2 years) and check interval.
RETENTION_WINDOW=17520h
RETENTION_CHECK_INTERVAL=1h
# Self-host limits. 0 means unlimited.
DAILY_LIMIT=0
MONTHLY_LIMIT=0
# ingest. Per-key rate limit.
RATE_LIMIT_PER_KEY=60
RATE_LIMIT_WINDOW=10s
# ingest, worker. Payload size limits.
MAX_BODY_BYTES=16384
MAX_MESSAGE_CHARS=5000
MAX_METADATA_BYTES=4096
# queue. Capacity and redelivery limits.
QUEUE_MAX_MSGS=100000
QUEUE_MAX_BYTES=268435456
QUEUE_MAX_DELIVER=5
# worker. Concurrency defaults to 1 for SQLite and 4 for Postgres when unset.
# WORKER_CONCURRENCY=
WORKER_BATCH_SIZE=500
WORKER_FETCH_MAX_WAIT=250ms
# ingest. Queue publish timeout.
PUBLISH_TIMEOUT=2s
# All modes. LOG_LEVEL is debug, info, warn or error; LOG_FORMAT is text or json.
LOG_LEVEL=info
LOG_FORMAT=text
